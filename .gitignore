# ── Generated / local Xcode project (XcodeGen) ─────────────────────────────
*.xcodeproj/
project.local.yml
project.generated.yml

# ── Signing & distribution ──────────────────────────────────────────────────
*.p12
*.mobileprovision
*.cer
*.pem
AuthKey_*.p8
*.provisionprofile
ExportOptionsLocal.plist

# ── Build & export artifacts ────────────────────────────────────────────────
DerivedData/
build/
.build/
*.xcarchive
*.ipa
*.dSYM.zip

# ── Secrets & env ───────────────────────────────────────────────────────────
.env
.env.*

# ── Xcode / SwiftPM ─────────────────────────────────────────────────────────
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
.swiftpm/

# ── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors ─────────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log

# ── Fonts (fetched, not committed) ──────────────────────────────────────────
# Fraunces + Inter variable .ttf masters are downloaded by scripts/fetch_fonts.sh
# (same posture as a-new-word-every-day). .gitkeep and OFL.txt stay committed.
RecipeToGroceryList/Resources/Fonts/*.ttf
RecipeToGroceryList/Resources/Fonts/*.otf

# ── Python tooling (scripts/ mirrors; byte-code is never committed) ──────────
__pycache__/
*.py[cod]
