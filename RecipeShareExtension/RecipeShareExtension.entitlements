<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Same App Group as the app — the extension writes inbox.json into this
	  container and nothing else (SPEC §5.1). Regenerated by XcodeGen from
	  project.yml; scripts/check_appgroup_sync.sh keeps the identifier aligned
	  with RecipeToGroceryList/Shared/AppGroup.swift.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lukewalton.recipetogrocerylist</string>
	</array>
</dict>
</plist>
