<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The App Store requires a privacy manifest per shipped bundle, so the Share
	  Extension carries its own. It collects nothing, tracks nothing, and contacts
	  no server. Its accessed-API array is EMPTY on purpose: the extension writes
	  one JSON file into the App Group container and touches no required-reason
	  API — not UserDefaults (the app's own manifest declares that one, CA92.1),
	  not file timestamps, not disk space.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
</dict>
</plist>
